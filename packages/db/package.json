{
  "name": "@clipforge/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "node -e 'const fs=require(\"fs\");if(fs.existsSync(\"../../.env\"))process.loadEnvFile(\"../../.env\");const {execSync}=require(\"child_process\");execSync(\"npx prisma migrate dev\",{stdio:\"inherit\"})'",
    "migrate:deploy": "node -e 'const fs=require(\"fs\");if(fs.existsSync(\"../../.env\"))process.loadEnvFile(\"../../.env\");const {execSync}=require(\"child_process\");execSync(\"npx prisma migrate deploy\",{stdio:\"inherit\"})'",
    "push": "node -e 'const fs=require(\"fs\");if(fs.existsSync(\"../../.env\"))process.loadEnvFile(\"../../.env\");const {execSync}=require(\"child_process\");execSync(\"npx prisma db push\",{stdio:\"inherit\"})'",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"No direct DB unit tests (covered by core/web tests)\""
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "typescript": "^5.7.2"
  }
}
