# =============================================================================
# ClipForge — Gaming Video Clipping Web App
# Copy this file to .env and replace placeholder values before running.
# Never commit real credentials or API keys to version control.
# =============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clipforge?schema=public"

# --- Authentication & Security ---
# Generate a random 32+ byte secret: openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string"
SESSION_TTL_DAYS="14"

# --- Application URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- YouTube Metadata Provider (Optional, Free) ---
# Official YouTube Data API v3 key (free tier: 10,000 quota units/day in Google Cloud Console).
# Used ONLY for permitted metadata lookup & live/archived stream detection — never downloads video.
# If left blank, automatically falls back to official free YouTube oEmbed (no key needed).
YOUTUBE_API_KEY=""

# --- Speech-to-Text Provider (100% Free Options Supported!) ---
# Mode: "auto" | "groq" | "local_whisper" | "custom" | "openai" | "none"
# In "auto" mode, ClipForge checks in order:
#   1. GROQ_API_KEY (FREE cloud Whisper — fastest & easiest, no credit card)
#   2. LOCAL_WHISPER_MODEL_PATH (100% FREE offline whisper.cpp on your Mac)
#   3. STT_BASE_URL (any self-hosted OpenAI-compatible Whisper server)
#   4. OPENAI_API_KEY (optional paid fallback)
#   5. Zero-key fallback (audio/scene/motion/face-cam analysis + manual caption review)
STT_PROVIDER="auto"

# FREE Option 1 (Recommended): Groq Free Tier (https://console.groq.com/keys)
GROQ_API_KEY=""
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"

# FREE Option 2 (100% Offline, Unlimited): Local whisper.cpp on Apple Silicon M-series GPU
# Install on macOS: brew install whisper-cpp
# Download models:   pnpm download:models (or bash scripts/download-models.sh)
# Choose model alias: "auto" (picks best available), "large-v3-turbo", "medium.en", "small.en", or "base.en"
LOCAL_WHISPER_BIN="whisper-cli"
LOCAL_WHISPER_MODEL="auto"
LOCAL_WHISPER_MODEL_PATH=""
WHISPER_THREADS="6"
WHISPER_PROMPT="Gaming livestream commentary, gameplay action, clutch reaction, GTA gameplay, streamer callouts, Vice City, Jason, Lucia"

# FREE Option 3: Self-hosted OpenAI-compatible Whisper server (e.g. faster-whisper-server)
STT_BASE_URL=""
STT_API_KEY=""
STT_MODEL="whisper-1"

# Paid Option (Not Required): OpenAI Whisper
OPENAI_API_KEY=""
OPENAI_WHISPER_MODEL="whisper-1"

# --- Object Storage ---
# Supported values: "local" | "s3"
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage"

# Required only when STORAGE_PROVIDER="s3" (AWS S3, Cloudflare R2, MinIO, etc.)
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# --- Upload & Media Limits ---
# Maximum authorized upload size in bytes (default: 1073741824 = 1 GiB)
MAX_UPLOAD_BYTES="1073741824"
TEMP_WORK_DIR="./tmp/clipforge-worker"
RETENTION_HOURS="72"

# --- FFmpeg Binaries (Optional) ---
# Leave blank to auto-resolve system ffmpeg/ffprobe or bundled ffmpeg-static/ffprobe-static
FFMPEG_PATH=""
FFPROBE_PATH=""

# --- Clip Selection Defaults (Configurable) ---
CLIP_DEFAULT_MIN_SECONDS="20"
CLIP_DEFAULT_MAX_SECONDS="60"
CLIP_DEFAULT_TARGET_SECONDS="35"
CLIP_SCORE_THRESHOLD="0.45"
CLIP_MAX_CANDIDATES="8"

# --- Worker Settings ---
WORKER_POLL_INTERVAL_MS="2000"
WORKER_CONCURRENCY="2"
WORKER_STALE_LOCK_MS="600000"
LOG_LEVEL="info"
